# MyWhoosh Credentials
MYWHOOSH_EMAIL=your_mywhoosh_email@example.com
MYWHOOSH_PASSWORD=your_mywhoosh_password

# Garmin Connect Credentials
GARMIN_USERNAME=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password
GARMIN_TOKEN_DIR=/root/.garminconnect

# Sync Configuration
SYNC_INTERVAL_MINUTES=15
SYNC_BATCH_SIZE=10
CHECK_DUPLICATES=true
DUPLICATE_THRESHOLD_HOURS=2

# Device Spoofing (Physio TrueUp / Training Load calculation in Garmin)
SPOOF_GARMIN_DEVICE=true
# 3927 = Garmin Edge 1040, 4024 = Garmin Edge 840
DEVICE_PRODUCT_ID=3927
DEVICE_SOFTWARE_VERSION=27.10

# Athlete FTP (Optional, for Normalized Power / TSS calculation in FIT file)
ATHLETE_FTP=0

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Data directory for SQLite sync state
DATA_DIR=/data
